{
  "$comment": "最小示例：只列常改项；未列出的键一律取 src/infra/default-config.mjs 的内置默认值，无需复制。",
  "gitDelivery": {
    "remote": "origin",
    "integrationBranch": "auto",
    "taskBranchPrefix": "wildarrange/task",
    "requireWorktreeForParallelWrites": true
  },
  "agents": {
    "BaiZe": { "provider": "host", "model": "host-default", "reasoning": "xhigh" }
  },
  "modelProviders": {
    "deepseek": {
      "type": "openai-compatible",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "baseUrlEnv": "DEEPSEEK_BASE_URL",
      "defaultBaseUrl": "https://api.deepseek.com"
    }
  },
  "qualityGates": {
    "commentChecker": { "enabled": true, "blockOnFindings": false }
  },
  "review": {
    "llm": { "enabled": false, "required": false, "agents": ["BaiZe"] }
  },
  "parallelAgents": {
    "defaultMaxAgents": 2
  }
}
