# WildArrange external model providers
# Copy this file to your shell secret store or project-local .env loader.
# Do not commit real values.

# DeepSeek
export DEEPSEEK_API_KEY="your-deepseek-api-key"
export DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Kimi / Moonshot
export KIMI_API_KEY="your-kimi-api-key"
export KIMI_BASE_URL="https://api.moonshot.cn/v1"

# Qwen / DashScope OpenAI-compatible mode
export QWEN_API_KEY="your-qwen-api-key"
export QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# Gemini-compatible gateway, only if you expose Gemini through an OpenAI-compatible endpoint.
export GEMINI_API_KEY="your-gemini-or-gateway-api-key"
export GEMINI_BASE_URL="your-openai-compatible-gemini-base-url"

# Optional dashboard token when binding the WildArrange dashboard beyond 127.0.0.1.
export HELIX_DASHBOARD_TOKEN="change-this-token"
