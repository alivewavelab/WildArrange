{
  "version": 1,
  "runtime": "helix-linear",
  "tools": [
    {
      "name": "helix_init",
      "layer": "runtime_state",
      "status": "implemented",
      "command": "node ./bin/helix.mjs init",
      "purpose": "创建 .helix 运行时状态、Agent 注册表、prompt-pack 注册表和 ledger。",
      "reads": ["packs/omo-linear/**"],
      "writes": [".helix/**"],
      "omoSource": ["packages/boulder-state", "packages/omo-opencode/src/features/team-mode/team-state-store"]
    },
    {
      "name": "helix_config",
      "layer": "runtime_state",
      "status": "implemented",
      "command": "node ./bin/helix.mjs config init --root | node ./bin/helix.mjs config show",
      "purpose": "生成或读取 `helix.config.json` / `.helix/config.json`。用于配置模型 provider/model/reasoning，以及每个注入点挂载哪些 tool、markdown、skill、rules。",
      "reads": ["helix.config.json", ".helix/config.json"],
      "writes": ["helix.config.json", ".helix/config.json", ".helix/ledger.jsonl"],
      "omoSource": ["packages/omo-codex/plugin/components/rules/src/config.ts", "packages/omo-codex/plugin/components/rules/src/codex-hook.ts"]
    },
    {
      "name": "helix_injection_show",
      "layer": "context_injection",
      "status": "implemented",
      "command": "node ./bin/helix.mjs injection show --point before_review --agent Oracle --task T001",
      "purpose": "解析某个注入点最终会挂载的 tools、markdown、skills 和 rules，用于调试 Codex/Cursor adapter 与 Agent 上下文是否接近 OMO hook 注入效果。",
      "reads": ["helix.config.json", ".helix/config.json", ".helix/prompt-pack.json", ".helix/**/*.md"],
      "writes": [],
      "omoSource": ["packages/omo-codex/plugin/components/rules/src/codex-hook.ts", "packages/omo-codex/plugin/components/rules/src/static-injection.ts"]
    },
    {
      "name": "helix_hook_run",
      "layer": "context_injection",
      "status": "implemented",
      "command": "node ./bin/helix.mjs hook run --from hook.json",
      "purpose": "Codex/Cursor adapter 入口：读取 SessionStart/UserPromptSubmit/PostToolUse/PostCompact/Stop hook payload，执行对应规则扫描、路由、续跑或范围检查，并输出可直接注入模型上下文的 Markdown。",
      "reads": ["helix.config.json", ".helix/config.json", ".helix/**", "AGENTS.md", "CLAUDE.md", ".omo/rules/**/*.md", ".cursor/rules/**/*.md"],
      "writes": [".helix/sessions/hooks/*.json", ".helix/rules/context.*", ".helix/snapshots/context.*", ".helix/ledger.jsonl"],
      "omoSource": ["packages/omo-codex/plugin/components/rules/src/codex-hook.ts", "packages/omo-codex/plugin/components/rules/src/static-injection.ts", "packages/omo-codex/plugin/components/rules/src/persistent-cache.ts"]
    },
    {
      "name": "helix_adapter_install",
      "layer": "host_adapter",
      "status": "implemented",
      "command": "node ./bin/helix.mjs adapter install --target all --mode local",
      "purpose": "生成 Codex hooks 配置和 Cursor rule 配置，把 HelixFlow 的 hook run 入口挂到宿主可调用的位置；默认不修改用户全局配置。",
      "reads": ["package.json", "helix.config.json", "packs/omo-linear/**"],
      "writes": [".helix/adapters/**", ".cursor/rules/helixflow.mdc", ".helix/ledger.jsonl"],
      "omoSource": ["packages/omo-codex/plugin/components/*/hooks/hooks.json", "packages/omo-codex/plugin/README.md"]
    },
    {
      "name": "pre_tool_use_guard",
      "layer": "gate",
      "status": "implemented",
      "command": "node ./bin/helix.mjs hook run --from pre-tool-use.json",
      "purpose": "按 OMO PreToolUse deny 格式，在工具执行前检查计划范围；计划外写入返回 permissionDecision=deny，防止先落盘后补救。",
      "reads": [".helix/team/tasks.json", "helix.config.json", "hook payload"],
      "writes": [".helix/sessions/hooks/*.json", ".helix/ledger.jsonl", ".helix/rules/context.*"],
      "omoSource": ["packages/omo-codex/plugin/components/ulw-loop/src/codex-hook.ts", "packages/omo-codex/plugin/components/git-bash/src/codex-hook.ts"]
    },
    {
      "name": "helix_resume",
      "layer": "runtime_state",
      "status": "implemented",
      "command": "node ./bin/helix.mjs resume [--session <id>]",
      "purpose": "从 .helix/work.json、tasks.json、ledger.jsonl 恢复中断会话位置；记录 session 血缘，并刷新 `.helix/snapshots/context.md` 供新 Codex/Cursor 会话直接读取。",
      "reads": [".helix/work.json", ".helix/team/tasks.json", ".helix/ledger.jsonl", ".helix/snapshots/latest.json", ".helix/sessions/lineage.json"],
      "writes": [".helix/ledger.jsonl", ".helix/sessions/lineage.json", ".helix/snapshots/context.json", ".helix/snapshots/context.md"],
      "omoSource": ["packages/omo-codex/plugin/components/start-work-continuation", "packages/omo-codex/plugin/components/ulw-loop/src/codex-hook.ts", "packages/omo-opencode/src/features/run-continuation-state", "packages/omo-opencode/src/cli/run/continuation-state.ts"]
    },
    {
      "name": "helix_continuation_check",
      "layer": "runtime_state",
      "status": "implemented",
      "command": "node ./bin/helix.mjs continuation check [--session <id>]",
      "purpose": "Codex/Cursor 会话停止前读取 .helix 状态；如果还有 runnable、active、failed、review_blocked 任务，输出下一步续跑指令，避免关闭会话丢上下文。",
      "reads": [".helix/work.json", ".helix/team/tasks.json", ".helix/ledger.jsonl", ".helix/snapshots/latest.json"],
      "writes": [".helix/sessions/continuation.json", ".helix/sessions/continuation.md", ".helix/ledger.jsonl"],
      "omoSource": ["packages/omo-codex/plugin/components/start-work-continuation/src/boulder-reader.ts", "packages/omo-codex/plugin/components/start-work-continuation/src/codex-hook.ts"]
    },
    {
      "name": "helix_rules_collect",
      "layer": "context_injection",
      "status": "implemented",
      "command": "node ./bin/helix.mjs rules collect [--target <path>]",
      "purpose": "扫描 AGENTS.md、CLAUDE.md、CONTEXT.md、.omo/.claude/.cursor/.github 规则，并按 target path/globs 生成 `.helix/rules/context.md`。",
      "reads": ["AGENTS.md", "CLAUDE.md", "CONTEXT.md", ".omo/rules/**/*.md", ".claude/rules/**/*.md", ".cursor/rules/**/*.md", ".github/instructions/**/*.md"],
      "writes": [".helix/rules/context.json", ".helix/rules/context.md", ".helix/ledger.jsonl"],
      "omoSource": ["packages/omo-codex/plugin/components/rules/src/rules/finder.ts", "packages/omo-codex/plugin/components/rules/src/rules/matcher.ts", "packages/omo-codex/plugin/components/rules/README.md"]
    },
    {
      "name": "helix_context_build",
      "layer": "context_injection",
      "status": "implemented",
      "command": "node ./bin/helix.mjs context build [--agent Atlas] [--task T001]",
      "purpose": "为单个简单上下文 Agent 生成任务、规则、变更路径、恢复指令和不可破坏 invariants 的输入包；后续接真实模型时作为 Agent 上下文。",
      "reads": [".helix/team/tasks.json", ".helix/snapshots/context.md", ".helix/rules/context.md", "git diff"],
      "writes": [".helix/context-agents/*.json", ".helix/context-agents/*.md", ".helix/ledger.jsonl"],
      "omoSource": ["packages/omo-codex/plugin/components/rules", "packages/omo-codex/plugin/components/start-work-continuation"]
    },
    {
      "name": "helix_snapshot_write",
      "layer": "runtime_state",
      "status": "implemented-in-loop",
      "command": "node ./bin/helix.mjs run",
      "purpose": "在关键节点写入可恢复快照，并同步刷新 `.helix/snapshots/context.md`，避免 Codex/Cursor 会话被关闭后丢上下文。",
      "reads": [".helix/**"],
      "writes": [".helix/snapshots/**"],
      "omoSource": ["packages/boulder-state", "packages/omo-opencode/src/features/boulder-state"]
    },
    {
      "name": "helix_plan_import",
      "layer": "planning",
      "status": "implemented",
      "command": "node ./bin/helix.mjs plan --from <plan.json>",
      "purpose": "把机器可读计划导入 .helix/team/tasks.json。",
      "reads": ["<plan.json>"],
      "writes": [".helix/plans/**", ".helix/team/tasks.*", ".helix/work.json", ".helix/ledger.jsonl"],
      "omoSource": ["packages/omo-opencode/src/tools/task", "packages/omo-opencode/src/features/team-mode/team-tasklist"]
    },
    {
      "name": "plan_validate",
      "layer": "planning",
      "status": "implemented",
      "command": "node ./bin/helix.mjs plan --from <plan.json>",
      "purpose": "验证任务必须有 subject、verify_commands，并在导入前检查 task id 唯一、blockedBy 指向已知任务、无自依赖、无循环依赖。",
      "reads": ["<plan.json>"],
      "writes": [".helix/ledger.jsonl"],
      "omoSource": ["packages/omo-opencode/src/tools/task/types.ts", "packages/omo-opencode/src/features/team-mode/team-tasklist/dependencies.ts", "packages/rules-engine"]
    },
    {
      "name": "helix_run_next",
      "layer": "execution_loop",
      "status": "implemented",
      "command": "node ./bin/helix.mjs run",
      "purpose": "让下一个 pending task 走完 worker、verifier、scope_guard、checkpoint、retry 和 ledger。",
      "reads": [".helix/team/tasks.json"],
      "writes": [".helix/**", "task.writable_paths"],
      "omoSource": ["packages/omo-opencode/src/features/team-mode/team-tasklist", "packages/omo-opencode/src/tools/delegate-task"]
    },
    {
      "name": "helix_workflow",
      "layer": "execution_loop",
      "status": "implemented",
      "command": "node ./bin/helix.mjs workflow --from <plan.json>",
      "purpose": "一键串起 init、plan import、run-until-idle、status、snapshot、workflow summary，用于模拟项目验收主路径。",
      "reads": ["<plan.json>", "packs/omo-linear/**"],
      "writes": [".helix/**", "task.writable_paths", ".helix/reports/workflow-summary.*"],
      "omoSource": ["packages/omo-opencode/src/features/team-mode", "packages/omo-opencode/src/tools/delegate-task"]
    },
    {
      "name": "helix_node",
      "layer": "execution_loop",
      "status": "implemented",
      "command": "node ./bin/helix.mjs node <route|execute|verify|scope|review|checkpoint|retry>",
      "purpose": "把 workflow 拆成可单独测试的节点：route、execute、verify、scope、review、checkpoint、retry。每个节点独立读写状态和 ledger。",
      "reads": [".helix/team/tasks.json", ".helix/prompt-pack.json", "packs/omo-linear/routes.json"],
      "writes": [".helix/**", "task.writable_paths", ".helix/reports/failures/**", ".helix/reports/reviews/**"],
      "omoSource": ["packages/omo-opencode/src/features/team-mode/team-tasklist/update.ts", "packages/omo-opencode/src/tools/delegate-task/sync-task-metadata.ts"]
    },
    {
      "name": "helix_serve",
      "layer": "runtime_state",
      "status": "implemented",
      "command": "node ./bin/helix.mjs serve --host 127.0.0.1 --port 8765",
      "purpose": "启动只读本地网页 dashboard，展示 status、tasks、route decisions、snapshots 和 ledger。",
      "reads": [".helix/**"],
      "writes": [],
      "omoSource": ["packages/omo-opencode/src/features/team-mode/team-runtime/status.ts", "packages/web"]
    },
    {
      "name": "helix_status",
      "layer": "runtime_state",
      "status": "implemented",
      "command": "node ./bin/helix.mjs status",
      "purpose": "显示当前 work 和任务计数。",
      "reads": [".helix/work.json", ".helix/team/tasks.json"],
      "writes": [],
      "omoSource": ["packages/omo-opencode/src/features/team-mode/team-runtime/status.ts"]
    },
    {
      "name": "helix_summary",
      "layer": "runtime_state",
      "status": "implemented",
      "command": "node ./bin/helix.mjs summary",
      "purpose": "生成或刷新 `.helix/reports/workflow-summary.json|md`，汇总任务状态、checkpoint、review/failure report、ChangeRequest 和 wisdom，作为模拟项目后的验收产物。",
      "reads": [".helix/work.json", ".helix/team/tasks.json", ".helix/checkpoints/**", ".helix/reports/**", ".helix/changes/**", ".helix/wisdom/**"],
      "writes": [".helix/reports/workflow-summary.json", ".helix/reports/workflow-summary.md", ".helix/ledger.jsonl"],
      "omoSource": ["packages/omo-opencode/src/agents/atlas", "packages/boulder-state"]
    },
    {
      "name": "helix_route",
      "layer": "routing",
      "status": "implemented",
      "command": "node ./bin/helix.mjs route --text <request>",
      "purpose": "按 OMO intent gate + category resolver 的裁剪规则，把用户请求解析为 primaryAgent、supportAgents、category、skills 和 nextCommand。",
      "reads": ["packs/omo-linear/routes.json", ".helix/work.json", ".helix/team/tasks.json", ".helix/snapshots/latest.json"],
      "writes": [".helix/ledger.jsonl", ".helix/snapshots/**"],
      "omoSource": ["packages/omo-opencode/src/agents/sisyphus/gpt-5-4.ts", "packages/omo-opencode/src/tools/delegate-task/category-resolver.ts", "packages/model-core/src/model-resolution-pipeline.ts"]
    },
    {
      "name": "scope_guard",
      "layer": "gate",
      "status": "implemented",
      "command": "node ./bin/helix.mjs guard scope --task <taskId>",
      "purpose": "在 checkpoint 或 merge 前，对照 task.writable_paths 检查 changed paths；计划外改动必须退回 Sisyphus/Prometheus 审核，并生成 ChangeRequest。",
      "reads": [".helix/team/tasks.json", "git diff", "git ls-files"],
      "writes": [".helix/ledger.jsonl", ".helix/changes/**"],
      "omoSource": ["packages/rules-engine", "packages/omo-opencode/src/features/team-mode/team-tasklist"]
    },
    {
      "name": "change_request_list",
      "layer": "change_control",
      "status": "implemented",
      "command": "node ./bin/helix.mjs changes list",
      "purpose": "列出 scope_guard 或 review blocker 生成的开放变更请求；只展示证据，不自动扩 scope。",
      "reads": [".helix/changes/**"],
      "writes": [],
      "omoSource": ["packages/omo-codex/plugin/components/ulw-loop/src/steering.ts", "packages/omo-codex/plugin/components/ulw-loop/src/review-blockers.ts"]
    },
    {
      "name": "change_request_review",
      "layer": "change_control",
      "status": "implemented",
      "command": "node ./bin/helix.mjs changes review --id <CR-id>",
      "purpose": "由 Sisyphus 对 ChangeRequest 做确定性审计：必须有 evidence/rationale，保持 autoApply=false，不允许削弱 verification/review gates。",
      "reads": [".helix/changes/<CR-id>.json"],
      "writes": [".helix/ledger.jsonl"],
      "omoSource": ["packages/omo-codex/plugin/components/ulw-loop/src/steering.ts", "packages/omo-codex/plugin/components/ulw-loop/src/review-blockers.ts"]
    },
    {
      "name": "change_request_resolve",
      "layer": "change_control",
      "status": "implemented",
      "command": "node ./bin/helix.mjs changes resolve --id <CR-id> --decision accept|reject --evidence <text> --rationale <text> [--apply-scope]",
      "purpose": "把负责人裁决写入 ChangeRequest。accept/reject 本身只落盘；只有显式 --apply-scope 才把被拒路径并入 task.writable_paths 并允许后续 retry。",
      "reads": [".helix/changes/<CR-id>.json", ".helix/team/tasks.json"],
      "writes": [".helix/changes/**", ".helix/team/tasks.json", ".helix/plans/**", ".helix/ledger.jsonl", ".helix/snapshots/**"],
      "omoSource": ["packages/omo-codex/plugin/components/ulw-loop/src/steering.ts"]
    },
    {
      "name": "helix_steer",
      "layer": "change_control",
      "status": "implemented",
      "command": "node ./bin/helix.mjs steer --from <proposal.json>",
      "purpose": "裁剪复刻 OMO steering：支持 add_task、split_task、reorder_pending、revise_acceptance、mark_blocked；必须 evidence+rationale，禁止削弱验收或伪造完成。",
      "reads": [".helix/team/tasks.json", "<proposal.json>"],
      "writes": [".helix/team/tasks.json", ".helix/plans/**", ".helix/ledger.jsonl", ".helix/snapshots/**"],
      "omoSource": ["packages/omo-codex/plugin/components/ulw-loop/src/steering.ts", "packages/omo-codex/plugin/components/ulw-loop/src/cli-steering.ts"]
    },
    {
      "name": "helix_evidence_record",
      "layer": "gate",
      "status": "implemented",
      "command": "node ./bin/helix.mjs evidence record --task T001 --criterion C001 --status pass --evidence <text>",
      "purpose": "为 task.successCriteria 记录 criterion 级证据；checkpoint 不再只看命令级 verifier，还要求 successCriteria 全 PASS。",
      "reads": [".helix/team/tasks.json"],
      "writes": [".helix/team/tasks.json", ".helix/plans/**", ".helix/ledger.jsonl"],
      "omoSource": ["packages/omo-codex/plugin/components/ulw-loop/src/evidence.ts", "packages/omo-codex/plugin/components/ulw-loop/src/checkpoint.ts", "packages/omo-codex/plugin/components/ulw-loop/src/quality-gate.ts"]
    },
    {
      "name": "helix_review_blocker_record",
      "layer": "change_control",
      "status": "implemented",
      "command": "node ./bin/helix.mjs review-blockers record --from <blocker.json>",
      "purpose": "把 final review blocker 记录成 review_blocked 状态，并追加独立 resolution task；原任务不被错误 checkpoint。",
      "reads": [".helix/team/tasks.json", "<blocker.json>"],
      "writes": [".helix/team/tasks.json", ".helix/plans/**", ".helix/ledger.jsonl", ".helix/snapshots/**"],
      "omoSource": ["packages/omo-codex/plugin/components/ulw-loop/src/review-blockers.ts"]
    },
    {
      "name": "review_gate",
      "layer": "gate",
      "status": "implemented",
      "command": "node ./bin/helix.mjs node review --task <taskId>",
      "purpose": "checkpoint 前运行目标符合、范围一致、证据质量、success criteria、项目规则、显式 review_commands、project standards 多 lane 复核；失败则不允许 checkpoint。",
      "reads": ["task.evidence", "task.successCriteria", "task.verify_commands", "task.review_commands", "task.standards_commands", "git diff", "project rules"],
      "writes": [".helix/team/tasks.json", ".helix/ledger.jsonl", ".helix/reports/reviews/**", ".helix/reports/failures/**", ".helix/rules/**"],
      "omoSource": ["packages/prompts-core/prompts/atlas", "packages/shared-skills/skills/review-work"]
    },
    {
      "name": "test_gate",
      "layer": "gate",
      "status": "implemented",
      "command": "task.verify_commands[]",
      "purpose": "每个任务必须配置可执行 verifier；失败则回到 pending 或 failed，写入可读 failure report，不允许 checkpoint。",
      "reads": ["task.verify_commands"],
      "writes": [".helix/team/tasks.json", ".helix/ledger.jsonl", ".helix/reports/failures/**"],
      "omoSource": ["packages/prompts-core/prompts/atlas", "packages/shared-skills/skills/debugging"]
    },
    {
      "name": "comment_check",
      "layer": "gate",
      "status": "contract-only",
      "command": "contract-only",
      "purpose": "检查新增注释是否解释真实复杂性，避免空话注释和 AI 味补丁。",
      "reads": ["git diff"],
      "writes": [".helix/ledger.jsonl"],
      "omoSource": ["packages/comment-checker-core"]
    },
    {
      "name": "wisdom_append",
      "layer": "memory",
      "status": "implemented",
      "command": "node ./bin/helix.mjs run",
      "purpose": "每个任务后追加可复用 learnings、decisions、issues 和 verification notes。",
      "reads": ["task.evidence"],
      "writes": [".helix/wisdom/**"],
      "omoSource": ["packages/boulder-state", "packages/omo-opencode/src/features/boulder-state"]
    },
    {
      "name": "grep_search",
      "layer": "code_intelligence",
      "status": "contract-only",
      "command": "rg <pattern>",
      "purpose": "做快速文本搜索；优先 rg，输出文件和行号，供 Explore/Librarian/Atlas 共享。",
      "reads": ["workspace files"],
      "writes": [],
      "omoSource": ["packages/omo-opencode/src/tools/grep"]
    },
    {
      "name": "glob_search",
      "layer": "code_intelligence",
      "status": "contract-only",
      "command": "rg --files",
      "purpose": "枚举候选文件，替代慢速全盘查找。",
      "reads": ["workspace files"],
      "writes": [],
      "omoSource": ["packages/omo-opencode/src/tools/glob"]
    },
    {
      "name": "ast_grep_search",
      "layer": "code_intelligence",
      "status": "contract-only",
      "command": "ast-grep --pattern <pattern>",
      "purpose": "按语法结构查找代码，而不是靠字符串猜测。",
      "reads": ["workspace files"],
      "writes": [],
      "omoSource": ["packages/ast-grep-core", "packages/ast-grep-mcp"]
    },
    {
      "name": "ast_grep_replace_dry_run",
      "layer": "code_intelligence",
      "status": "contract-only",
      "command": "ast-grep --pattern <pattern> --rewrite <rewrite> --dry-run",
      "purpose": "批量改代码前先做结构化 dry-run，避免正则误伤。",
      "reads": ["workspace files"],
      "writes": [],
      "omoSource": ["packages/ast-grep-core", "packages/ast-grep-mcp"]
    },
    {
      "name": "lsp_diagnostics",
      "layer": "code_intelligence",
      "status": "contract-only",
      "command": "contract-only",
      "purpose": "读取语言服务器诊断，作为 Metis 找 BUG 和 Oracle 验收的证据。",
      "reads": ["workspace files", "language server"],
      "writes": [],
      "omoSource": ["packages/lsp-daemon", "packages/lsp-tools-mcp"]
    },
    {
      "name": "lsp_references",
      "layer": "code_intelligence",
      "status": "contract-only",
      "command": "contract-only",
      "purpose": "跨文件查引用，支持安全重构和影响面判断。",
      "reads": ["workspace files", "language server"],
      "writes": [],
